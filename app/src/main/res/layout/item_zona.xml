<?xml version="1.0" encoding="utf-8"?>
<!-- Fila reutilizable con la ocupación de una zona -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/txtZona"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/cp_texto"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtZonaDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/cp_texto_suave"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/barraZona"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressTint="@color/cp_azul" />
</LinearLayout>
